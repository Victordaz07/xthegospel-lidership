rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function myWardId() {
      return userDoc(request.auth.uid).wardMembership.wardId;
    }

    function sameWard(wardId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).wardMembership != null
        && myWardId() == wardId;
    }

    // undefined/null => false
    function isLeader() {
      return userDoc(request.auth.uid).wardMembership.isLeader == true;
    }
    
    // Perfiles de usuario: solo el propio usuario puede leer/escribir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Llamamientos, responsabilidades, notas, eventos y observaciones del líder
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Barrios/ramas: usuarios autenticados pueden leer; crear/actualizar requiere auth
    match /wards/{wardId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
      
      // Preparación bautismal: SOLO líderes del barrio (isLeader == true)
      match /baptismPreparation/{memberId} {
        allow read, write: if sameWard(wardId) && isLeader();
      }
      
      // Sesiones de enseñanza
      match /teachingSessions/{sessionId} {
        allow read, write: if request.auth != null;
        
        match /participants/{participantId} {
          allow read, write: if request.auth != null;
        }
        
        match /feedback/{feedbackId} {
          allow read, write: if request.auth != null;
        }
      }
    }
    
    // Códigos de unión a barrio: lectura para unirse, escritura por admins
    match /wardCodes/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
