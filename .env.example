# =============================================================================
# Firebase Configuration - xTheGospel Leaders
# =============================================================================
# 
# IMPORTANTE: Este proyecto comparte el mismo proyecto Firebase con la app
# de miembros (xthegospel). Esto permite:
#
# 1. Autenticación compartida - Un usuario puede usar la misma cuenta en ambas apps
# 2. Datos interconectados - Los líderes pueden ver información de miembros
# 3. Sincronización - Cambios en una app se reflejan en la otra
#
# =============================================================================
# Copia este archivo a .env.local y usa las MISMAS credenciales del proyecto
# Firebase de xthegospel (app de miembros)
# =============================================================================

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-app-id

# =============================================================================
# Feature Flags (opcional)
# =============================================================================

# Habilitar sincronización con la nube (default: false)
# VITE_CLOUD_SYNC_ENABLED=true
